      ]
    },
    {
      "parameters": {
        "formTitle": "Instagram Multi-Agent Content Factory",
        "formDescription": "Choose a format and topic. 'script' only sends a reel script to Telegram. 'carousel' and 'image' also create images and can post to Instagram. Image Model is ignored for 'script'. Empty fields use the defaults.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Format",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "script"
                  },
                  {
                    "option": "carousel"
                  },
                  {
                    "option": "image"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Topic",
              "placeholder": "e.g. ChatGPT Ads for business (leave empty to pick a trending topic)"
            },
            {
              "fieldLabel": "Niche",
              "placeholder": "Used only when Topic is empty. Default: AI automation and n8n for beginners"
            },
            {
              "fieldLabel": "Audience",
              "placeholder": "Default: Non-technical Indian learners, students and freelancers"
            },
            {
              "fieldLabel": "Language",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Hinglish"
                  },
                  {
                    "option": "English"
                  },
                  {
                    "option": "Hindi"
                  }
                ]
              },
              "requiredField": false
            },
            {
              "fieldLabel": "Brand Voice",
              "placeholder": "Default: Friendly teacher, simple words, practical, no jargon"
            },
            {
              "fieldLabel": "Country",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "IN"
                  },
                  {
                    "option": "US"
                  },
                  {
                    "option": "GB"
                  },
                  {
                    "option": "AE"
                  }
                ]
              },
              "requiredField": false
            },
            {
              "fieldLabel": "Instructions",
              "placeholder": "Rules the Validator must follow (leave empty for default rules)",
              "fieldType": "textarea"
            },
            {
              "fieldLabel": "Image Model",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "gemini-2.5-flash-image"
                  },
                  {
                    "option": "gemini-3.1-flash-image"
                  }
                ]
              },
              "requiredField": false
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Create content",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Submitted! The agents are working. Check Telegram in a few minutes."
            }
          }
        }
      },
      "id": "c739a356-de9d-4b21-9b19-72bc1f8cb559",
