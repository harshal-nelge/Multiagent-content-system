    {
      "parameters": {
        "jsCode": "const f = $input.first().json;\nconst v = (k) => String(f[k] || '').trim();\nreturn [{ json: { body: {\n  format: v('Format'), topic: v('Topic'), niche: v('Niche'), audience: v('Audience'),\n  language: v('Language'), brand_voice: v('Brand Voice'), geo: v('Country'),\n  instructions: v('Instructions'), image_model: v('Image Model')\n} } }];"
      },
