        "text": "={{ ('🎬 REEL SCRIPT\\n\\n🧠 Topic: ' + $('Agent 3 - Strategist').first().json.strategy.chosen_topic + '\\n🎣 Hook: ' + $('Agent 3 - Strategist').first().json.strategy.hook + '\\n\\n' + $('Agent 3 - Strategist').first().json.strategy.script_scenes.map((x, i) => '▶️ Scene ' + (x.scene || i + 1) + '\\n🎥 Visual: ' + x.visual + '\\n🎙 Voiceover: ' + x.voiceover).join('\\n\\n') + '\\n\\n📣 CTA: ' + $('Agent 3 - Strategist').first().json.strategy.cta + '\\n\\n📝 Caption:\\n' + $('Agent 3 - Strategist').first().json.strategy.caption + '\\n\\n' + $('Agent 3 - Strategist').first().json.strategy.hashtags.join(' ')).slice(0, 3800).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
